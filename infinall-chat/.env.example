LLM_GATEWAY_BASE_URL=https://your-gateway-url-here.com
LLM_GATEWAY_API_KEY=sk-your-api-key-here

# Required: HMAC secret for mutation approval tokens (min 32 chars)
# Generate with: openssl rand -hex 32
APPROVAL_HMAC_SECRET=

# Authentication mode. Use "dev" only for local fixture sessions; omit in production.
AUTH_MODE=dev

# Optional: MCP Mode (mock | live). Defaults to mock.
MCP_MODE=mock

# Optional: Firecrawl API Key
FIRECRAWL_API_KEY=

# Optional: Google Analytics 4 Property ID
GA4_PROPERTY_ID=

# Optional: Meta Ads Account ID
META_ACCOUNT_ID=

# Supabase (PRD §11: Cloud PostgreSQL, Full-Text Search, Vector & Storage)
# Set these in .env.local to enable live Supabase persistence.
# If omitted or left blank, Infinall Chat automatically uses the built-in local durable storage engine in .data/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: Redis (future: durable approval store, distributed rate limiting)
REDIS_URL=

# Per-user connector credential encryption (32+ random bytes recommended).
CONNECTOR_ENCRYPTION_KEY=

# Generic OAuth provider settings are read as <CONNECTOR_ID>_OAUTH_*.
# Example: GOOGLE_DRIVE_OAUTH_AUTHORIZE_URL, GOOGLE_DRIVE_OAUTH_TOKEN_URL,
# GOOGLE_DRIVE_OAUTH_CLIENT_ID, GOOGLE_DRIVE_OAUTH_CLIENT_SECRET,
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000
